{
  "version": 1,
  "meta": {
    "id": "guardian_autonomous_bot",
    "name": "Guardian Autonomous Bot",
    "category": "bot",
    "author": "MSM",
    "description": "Vollständiges Beispiel mit Health-Probes, Diagnose, begrenzter Recovery und Quarantäne."
  },
  "runtime": {
    "image": "node:22-bookworm-slim",
    "workdir": "/data",
    "user": "1000:1000",
    "env": {
      "PORT": "{WEB_PORT}"
    },
    "startup": "node index.js",
    "ensureDirs": ["logs", "runtime"],
    "requiredFiles": ["package.json"]
  },
  "ports": [
    {
      "name": "web",
      "protocol": "tcp"
    }
  ],
  "source": {
    "type": "github",
    "updateStrategy": "checkBased",
    "github": {
      "repo": "your-org/your-bot",
      "branch": "main",
      "setupCommands": [
        ["npm", "ci"]
      ]
    }
  },
  "backup": {
    "includePaths": ["config", "data"]
  },
  "health": {
    "process": {
      "required": true,
      "id": "process",
      "interval": "15s",
      "failure_threshold": 1,
      "success_threshold": 1,
      "required_for_startup": true,
      "required_for_verification": true
    },
    "application": {
      "type": "http-ping",
      "id": "health-endpoint",
      "port": "{{PORT:web}}",
      "path": "/healthz",
      "interval": "30s",
      "timeout": "3s",
      "failure_threshold": 3,
      "success_threshold": 2,
      "expected_statuses": [200],
      "follow_redirects": false,
      "max_response_bytes": 4096,
      "required_for_startup": false,
      "required_for_verification": true
    },
    "startup": {
      "grace_period_seconds": 20,
      "timeout_seconds": 180,
      "success_patterns": ["Listening on port"],
      "failure_patterns": ["Address already in use", "npm ERR!"]
    }
  },
  "logs": {
    "sources": ["stdout", "logs/*.log"],
    "redact": ["discord_token", "api_key", "authorization_header", "database_url"],
    "max_tail_bytes": 65536
  },
  "diagnostics": {
    "parsers": ["linux-oom", "nodejs-stacktrace", "port-conflict", "missing-runtime", "startup-pattern"]
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "http_request_failed",
        "action": "restart"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "startup-pattern",
        "action": "quarantine"
      }
    ],
    "safe_lock_files": [
      {
        "path": "runtime/app.lock",
        "reason": "Die Anwendung legt diese bekannte, gefahrlos neu erzeugbare Lockdatei an."
      }
    ],
    "max_attempts": 3,
    "attempt_window_seconds": 1800,
    "cooldown_seconds": 300,
    "verification": {
      "minimum_healthy_duration_seconds": 30,
      "required_consecutive_successes": 3,
      "verification_timeout_seconds": 180
    }
  },
  "backups": {
    "before_risky_action": true,
    "protected_paths": ["config/", "data/"]
  }
}
