{
  "version": 1,
  "meta": {
    "id": "ark_ascended",
    "name": "ARK: Survival Ascended (ASA)",
    "category": "steam_game",
    "author": "Maunting Studios",
    "description": "ARK: Survival Ascended Dedicated Server (App-ID 2430930) via SteamCMD. Windows-Binary wird über GE-Proton in einem virtuellen Display (Xvfb) gestartet. Maps: TheIsland_WP, ScorchedEarth_WP, TheCenter_WP, Aberration_WP, Extinction_WP, Ragnarok_WP, Valguero_WP, Astraeos_WP, LostColony_WP, Fjordur_WP, ClubArk_WP."
  },
  "runtime": {
    "image": "ghcr.io/einmalmaik/msm-asa-runtime:ge-proton10-34-umu1.4.0",
    "workdir": "/home/container",
    "user": "1000:1000",
    "env": {
      "WINEPREFIX": "/home/container/.umu-prefix-2430930",
      "MAX_PLAYERS": "70",
      "MAP_NAME": "TheIsland_WP"
    },
    "startup": "xvfb-run -a /opt/umu-launcher/umu-run ./ShooterGame/Binaries/Win64/ArkAscendedServer.exe {ENV.MAP_NAME}?listen?MaxPlayers={ENV.MAX_PLAYERS}?SessionName=\"{SERVER_NAME}\"?Port={GAME_PORT}?QueryPort={QUERY_PORT}?RCONPort={RCON_PORT}?RCONEnabled=True -WinLiveMaxPlayers={ENV.MAX_PLAYERS} -oldconsole -servergamelog -Port={GAME_PORT} -QueryPort={QUERY_PORT} -RCONPort={RCON_PORT} -RCONEnabled=True -NoBattlEye -crossplay -server -game -log {MOD_ARG}",
    "ensureDirs": [
      ".local/share/umu",
      "ShooterGame/Saved/Config/WindowsServer",
      "ShooterGame/Saved/SavedArks",
      "ShooterGame/Saved/Logs"
    ],
    "requiredFiles": [
      "ShooterGame/Binaries/Win64/ArkAscendedServer.exe"
    ],
    "configPatches": [
      {
        "type": "ini",
        "file": "ShooterGame/Saved/Config/WindowsServer/GameUserSettings.ini",
        "section": "ServerSettings",
        "key": "RCONPort",
        "value": "{RCON_PORT}"
      }
    ],
    "stopGracePeriodSeconds": 60,
    "startupCheckSeconds": 90.0,
    "allowUnprivilegedUserNamespaces": true
  },
  "ports": [
    {
      "name": "game",
      "protocol": "udp"
    },
    {
      "name": "peer",
      "protocol": "udp"
    },
    {
      "name": "query",
      "protocol": "udp"
    },
    {
      "name": "rcon",
      "protocol": "tcp"
    }
  ],
  "source": {
    "type": "steam",
    "steam": {
      "appId": "2430930",
      "platform": "windows",
      "compatibility": "proton",
      "requiresLogin": false,
      "validate": false
    },
    "updateStrategy": "checkBased"
  },
  "mods": {
    "supportsMods": true,
    "supportsSteamWorkshop": false,
    "workshopAppId": null,
    "supportsCurseForge": true,
    "curseforgeGameId": "83374",
    "curseforgeClassId": null,
    "curseforgeInstallPath": null,
    "filterTags": [],
    "modInjection": "startupArg",
    "modStartupArgumentFormat": "-mods={mods}",
    "modStartupArgumentSeparator": ",",
    "modListFilePath": null,
    "modListContent": "workshopIds",
    "postInstall": []
  },
  "health": {
    "process": {},
    "startup": {
      "grace_period_seconds": 600,
      "timeout_seconds": 1800,
      "success_patterns": [
        "Server has completed startup and is now advertising for join",
        "Full Startup:",
        "advertising for join",
        "Server successfully started",
        "Setting breakpad minidump AppID",
        "wp.Runtime.HLOD",
        "Event queue: No events to send"
      ],
      "failure_patterns": [
        "Address already in use",
        "Could not bind",
        "System\\.PlatformNotSupportedException",
        "No displays available"
      ]
    }
  },
  "logs": {
    "sources": [
      "ShooterGame/Saved/Logs/ShooterGame.log",
      "stdout"
    ],
    "redact": [
      "regex:ServerPassword",
      "regex:ServerAdminPassword",
      "regex:ADMIN_PASSWORD"
    ]
  },
  "diagnostics": {
    "parsers": [
      "linux-oom",
      "port-conflict"
    ]
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      }
    ],
    "attempt_window_seconds": 600,
    "max_attempts": 3,
    "cooldown_seconds": 60
  },
  "backup": {
    "includePaths": [
      "ShooterGame/Saved/Config",
      "ShooterGame/Saved/SavedArks",
      "ShooterGame/Saved/Logs"
    ]
  }
}