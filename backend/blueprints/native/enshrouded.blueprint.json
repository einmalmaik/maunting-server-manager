{
  "version": 1,
  "meta": {
    "id": "enshrouded",
    "name": "Enshrouded",
    "category": "steam_game",
    "author": "Maunting Studios",
    "description": "Enshrouded Dedicated Server via SteamCMD (App-ID 2278520). Die Windows-Serverdateien laufen unter Wine; ein Steam-Account ist nicht erforderlich. Konfiguration über enshrouded_server.json."
  },
  "runtime": {
    "image": "ghcr.io/parkervcp/yolks:wine_10",
    "workdir": "/home/container",
    "user": "1000:1000",
    "env": {
      "WINEDEBUG": "-all",
      "WINEESYNC": "1",
      "WINEFSYNC": "1"
    },
    "startup": "./enshrouded_server.exe",
    "ensureDirs": [
      "logs",
      "savegame"
    ],
    "requiredFiles": [
      "enshrouded_server.exe"
    ],
    "seedFiles": [
      {
        "file": "enshrouded_server.json",
        "content": "{\n  \"name\": \"Enshrouded Server\",\n  \"password\": \"\",\n  \"saveDirectory\": \"./savegame\",\n  \"logDirectory\": \"./logs\",\n  \"ip\": \"0.0.0.0\",\n  \"queryPort\": {QUERY_PORT},\n  \"slotCount\": 16\n}\n"
      }
    ],
    "configPatches": [
      {
        "type": "regex",
        "file": "enshrouded_server.json",
        "regex": "(\"queryPort\"\\s*:\\s*)\\d+",
        "value": "\\g<1>{QUERY_PORT}"
      }
    ],
    "stopGracePeriodSeconds": 60,
    "startupCheckSeconds": 120.0
  },
  "ports": [
    {
      "name": "query",
      "protocol": "udp"
    }
  ],
  "source": {
    "type": "steam",
    "steam": {
      "appId": "2278520",
      "platform": "windows",
      "compatibility": "proton",
      "requiresLogin": false,
      "validate": false
    },
    "updateStrategy": "checkBased"
  },
  "mods": {
    "supportsMods": false,
    "supportsSteamWorkshop": false,
    "workshopAppId": null,
    "modInjection": "none",
    "modStartupArgumentFormat": null,
    "modListFilePath": null,
    "modListContent": "workshopIds",
    "postInstall": []
  },
  "health": {
    "process": {},
    "application": {
      "type": "source-query",
      "port": "{{QUERY_PORT}}",
      "interval": "60s",
      "failure_threshold": 3
    },
    "startup": {
      "grace_period_seconds": 60,
      "success_patterns": [
        "Switching state from LoadEcsScene to Run",
        "-------------- Session ----------------"
      ],
      "failure_patterns": [
        "Address already in use",
        "Could not bind",
        "Parsing .* failed"
      ]
    }
  },
  "logs": {
    "sources": [
      "logs/enshrouded_server.log",
      "stdout"
    ],
    "redact": [
      "regex:password"
    ]
  },
  "diagnostics": {
    "parsers": [
      "linux-oom",
      "port-conflict"
    ]
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "source_query_failed",
        "action": "restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      }
    ],
    "attempt_window_seconds": 600,
    "max_attempts": 3,
    "cooldown_seconds": 60
  },
  "backup": {
    "includePaths": [
      "enshrouded_server.json",
      "savegame"
    ]
  }
}
