# MSM Backend im Linux-Container (dev). Python 3.12 wie auf dem Server
# (Ubuntu 24.04): die gepinnten psycopg2-binary/asyncpg-Versionen bauen
# unter 3.13 nicht (entfernte CPython-APIs), unter 3.12 schon.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Systempakete für psycopg2/asyncpg + onnxruntime + Healthcheck
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt dev-requirements.txt ./
# Getrennt installieren: requirements pinnt pyyaml==6.0.2, dev-requirements
# PyYAML==6.0.3 — in einem pip-Lauf kollidieren die Pins (ResolutionImpossible),
# nacheinander upgradet der zweite Lauf sauber (wie venv-Setup auf Windows).
RUN pip install --upgrade pip -q && pip install -q -r requirements.txt
RUN pip install -q -r dev-requirements.txt

# Code wird per Volume gemountet (Reload); COPY nur als Fallback
COPY . .

EXPOSE 8000

# Linux-Pfade wie auf dem Server anlegen (Rechte offen für Dev)
RUN mkdir -p /opt/msm/backups /opt/msm/servers /opt/msm/vault-blobs /opt/msm/blueprints/community /data/servers /data/vault-blobs \
    && chmod -R 777 /opt/msm /data

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
