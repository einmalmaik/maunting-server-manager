{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maunting Smart System",
  "mainBinaryName": "MauntingSmartSystem",
  "version": "5.5.1",
  "identifier": "com.mauntingstudios.smart-system",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev:desktop",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm --prefix ../frontend run build:desktop",
    "frontendDist": "../../frontend/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MSS — Maunting Smart System",
        "url": "desktop.html",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      },
      {
        "label": "overlay",
        "title": "MSS",
        "url": "desktop.html?fenster=overlay",
        "width": 480,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http: ws: wss:; img-src 'self' data: https: http: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "MauntingStudios",
    "copyright": "© 2026 MauntingStudios",
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
