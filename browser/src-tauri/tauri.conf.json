{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maunting Secure Browser",
  "mainBinaryName": "MauntingSecureBrowser",
  "version": "1.0.0",
  "identifier": "com.mauntingstudios.secure-browser",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev:browser",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm --prefix ../frontend run build:browser",
    "frontendDist": "../../frontend/dist-browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MSB — Maunting Secure Browser",
        "url": "browser.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http: ws: wss:; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "MauntingStudios",
    "copyright": "© 2026 MauntingStudios",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
