{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maunting Pontis",
  "mainBinaryName": "MauntingPontis",
  "version": "5.7.3",
  "identifier": "com.mauntingstudios.secure-browser",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev:browser",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm --prefix ../frontend run build:browser",
    "frontendDist": "../../frontend/dist-browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maunting Pontis",
        "url": "browser.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "MauntingStudios",
    "copyright": "© 2026 MauntingStudios",
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
