{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maunting Secure Browser",
  "mainBinaryName": "MauntingSecureBrowser",
  "version": "5.3.2",
  "identifier": "com.mauntingstudios.secure-browser",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev:browser",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "npm --prefix ../frontend run build:browser",
    "frontendDist": "../../frontend/dist-browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MSB — Maunting Secure Browser",
        "url": "browser.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "MauntingStudios",
    "copyright": "© 2026 MauntingStudios",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1QjEzNDY1RDUxNjEzNTIKUldSU0V4YlZaVFN4RldBU3BTdmZxVWc2bXkzYUloYmxBWGl0czUrTk9ESFhiclp1U2pEYkNBWFoK",
      "endpoints": [
        "https://github.com/einmalmaik/maunting-server-manager/releases/latest/download/latest-msb.json"
      ]
    }
  }
}
