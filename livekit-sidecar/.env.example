# Wird von install.sh als .env erzeugt. Diese Datei dient nur der Dokumentation.
#
# LIVEKIT_KEYS traegt Schluessel und Geheimnis im Format "<key>: <secret>".
# Genau dasselbe Paar steht als MSM_LIVEKIT_API_KEY / MSM_LIVEKIT_API_SECRET in
# der Backend-Environment. Weichen die beiden Seiten voneinander ab, weist der
# Sidecar jedes Token ab und jeder Anruf scheitert beim Verbinden.
LIVEKIT_KEYS="APIxxxxxxxxxxxx: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# NODE_IP ist die IPv4-Adresse, die der Sidecar Anrufern fuer die Medienports
# nennt. install.sh und update.sh ermitteln sie mit medienadresse.py aus der
# Panel-Domain. Fuer einen Server hinter Proxy oder CDN in der Backend-.env
# MSM_LIVEKIT_NODE_IP setzen; diese Datei wird bei jedem Lauf neu geschrieben.
NODE_IP="203.0.113.10"
