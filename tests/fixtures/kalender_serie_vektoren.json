    {
      "name": "Ende vor Beginn: der Termin bleibt trotzdem sichtbar",
      "_warum": "Ein vertipptes Endjahr ergibt eine Regel, die endet, bevor sie anfaengt. Sie liefert dann in KEINEM Zeitraum ein Vorkommen - der Termin ist nirgends zu sehen, und anklicken und richtigstellen kann ihn auch niemand mehr. Also bleibt das urspruengliche Vorkommen stehen, wie bei einer unlesbaren Regel.",
      "rrule": "FREQ=YEARLY;UNTIL=20200101",
      "start": "2026-03-14T09:00:00Z",
      "ende": "2026-03-14T10:00:00Z",
      "zeitzone": "Europe/Berlin",
      "fenster_von": "2026-01-01T00:00:00Z",
      "fenster_bis": "2027-01-01T00:00:00Z",
      "erwartet": [
        { "schluessel": "2026-03-14", "start": "2026-03-14T09:00:00Z", "ende": "2026-03-14T10:00:00Z" }
      ]
    },
