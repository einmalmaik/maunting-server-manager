# Caddy-Konfiguration für Maunting Service Manager
# Wird durch install.sh automatisch generiert. Manuelle Änderungen gehen bei Re-Install verloren.

{{DOMAIN}} {
    root * /opt/msm/frontend/dist

    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        # microphone=(self): der Realtime-Sprachmodus des Panels braucht
        # getUserMedia auf der eigenen Herkunft. microphone=() blockierte ihn
        # vollstaendig — der Browser fragte nicht einmal. Fremde iframes
        # bleiben mit (self) weiterhin ausgesperrt.
        # camera=(self) und display-capture=(self) aus demselben Grund: der
        # Messenger kann Video- und Bildschirmanrufe. Mit camera=() fragte der
        # Browser auch hier nicht, und die Kamera blieb im Gespraech tot.
        Permissions-Policy "accelerometer=(), camera=(self), display-capture=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), payment=(), usb=()"
    }

    handle /api/* {
        header Cache-Control "no-store"
        reverse_proxy localhost:8000
    }

    handle /ws/* {
        reverse_proxy localhost:8000
    }

    # LiveKit-Sidecar: Signalisierung fuer Anrufe. handle_path schneidet das
    # Praefix ab, damit /livekit/rtc beim Medienserver als /rtc ankommt.
    # Der Sidecar hoert nur auf 127.0.0.1; dies ist sein einziger Weg nach
    # aussen, und er traegt damit dasselbe Zertifikat wie das Panel.
    handle_path /livekit/* {
        reverse_proxy localhost:7880
    }

    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        header Cache-Control "no-cache, no-store, must-revalidate"
        try_files {path} /index.html
        file_server
    }

    tls internal
}
